{
  "name": "travel-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Scraper ofert last minute + API + frontend",
  "workspaces": [
    "scraper",
    "api",
    "web"
  ],
  "scripts": {
    "scrape": "npm run scrape --workspace scraper",
    "scrape:once": "node scraper/src/index.js --once",
    "api": "npm run dev --workspace api",
    "web": "npm run dev --workspace web",
    "install:all": "npm install",
    "dev": "npm run api && npm run web"
  }
}
