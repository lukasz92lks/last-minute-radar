# Włącz scrapowanie wakacje.pl (domyślnie wyłączone - strona ma mocną ochronę anty-bot i bywa niestabilna)
# SCRAPE_WAKACJE=1 node scrapers/src/index.js

# Adres URL API (domyślnie http://localhost:4000)
# API_URL=http://localhost:4000

# Port API Express (domyślnie 4000)
# PORT=4000

# Ścieżka do pliku bazy SQLite (domyślnie api/data/travel.db)
# DB_PATH=C:\path\to\travel.db
