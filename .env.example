# --- Supabase (baza danych) ---
# URL projektu Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Klucz dostępowy:
# - Scraper lokalny / CI: użyj service_role (pełny dostęp, traktuj jak sekret)
# - Vercel (Route Handlers): użyj service_role lub anon
SUPABASE_SERVICE_KEY=your-service-or-anon-key

# --- Scraper ---
# Włącz scrapowanie wakacje.pl (domyślnie wyłączone - strona ma mocną ochronę anty-bot i bywa niestabilna)
# SCRAPE_WAKACJE=1

# --- Lokalny API Express (opcjonalny, tylko do testów; na Vercel działa Next.js Route Handlers) ---
# PORT=4000
# API_URL=http://localhost:4000